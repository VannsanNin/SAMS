{
  "$schema": "https://impeccable.dev/schema/v1.json",
  "name": "SAMS Impeccable Design System",
  "version": "1.0.0",
  "theme": {
    "colors": {
      "primary": {
        "50": "#eef2ff",
        "100": "#e0e7ff",
        "500": "#6366f1",
        "600": "#4f46e5",
        "700": "#4338ca",
        "900": "#1e1b4b"
      },
      "accent": {
        "500": "#f59e0b",
        "600": "#d97706"
      },
      "surface": {
        "page": "#f8fafc",
        "card": "#ffffff",
        "cardHover": "#f1f5f9",
        "border": "#e2e8f0"
      },
      "semantic": {
        "success": "#10b981",
        "warning": "#f59e0b",
        "danger": "#ef4444",
        "info": "#3b82f6"
      }
    },
    "typography": {
      "sans": ["Inter", "system-ui", "sans-serif"],
      "display": ["Plus Jakarta Sans", "Inter", "sans-serif"],
      "mono": ["JetBrains Mono", "monospace"]
    },
    "borderRadius": {
      "sm": "0.375rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "xl": "1rem"
    },
    "shadows": {
      "subtle": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
      "card": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "elevated": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "glass": "0 8px 32px 0 rgba(31, 38, 135, 0.07)"
    }
  },
  "rules": [
    "Always use defined color tokens instead of raw hex values",
    "Maintain consistent line heights and font hierarchy",
    "Ensure WCAG AAA contrast ratio for text elements",
    "Apply subtle micro-interactions on hover and click states",
    "Use semantic icons from lucide-react with standard sizes (16, 20, 24)",
    "Implement glassmorphism and soft backdrop blurs for modals and floating navs",
    "Provide responsive layouts optimized for mobile, tablet, and desktop viewports"
  ]
}
